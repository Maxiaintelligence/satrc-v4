# ==============================================================================
# VARIABLES DE ENTORNO - SatRC v4.0 (Sistema de Alerta Temprana)
# Copiar este archivo como .env.local para desarrollo local
# ==============================================================================

# Entorno de ejecución (development | production | test)
NODE_ENV=development

# Zona horaria del sistema (Centro de México)
TZ=America/Mexico_City

# Nivel de logging estructurado (debug | info | warn | error)
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# SUPABASE (Base de datos PostgreSQL + Realtime)
# ------------------------------------------------------------------------------

# URL del proyecto Supabase (ej. https://xkavbesvhbpmoklrpzyx.supabase.co)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima (para consumo cliente)
SUPABASE_ANON_KEY=tu_anon_key

# Clave de servicio con permisos de bypass RLS (solo backend / pipeline)
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# ------------------------------------------------------------------------------
# GROQ API (Capa Narrativa - Llama 3.3 70B Versatile)
# ------------------------------------------------------------------------------

# Clave API gratuita de Groq
GROQ_API_KEY=gsk_tu_api_key

# URL base del endpoint de chat completions
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Modelo asignado para redacción narrativa técnica
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# SEGURIDAD Y ORQUESTACIÓN CRON
# ------------------------------------------------------------------------------

# Token secreto para autorizar la ejecución del endpoint /api/sara
CRON_SECRET=clave_secreta_super_segura_para_el_cron