{
  "name": "satrc-v4",
  "version": "4.0.0",
  "private": true,
  "description": "Sistema de Alerta Temprana ante Riesgos Hidrometeorológicos y Climáticos - Arquidiócesis de Tulancingo",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node src/index.js",
